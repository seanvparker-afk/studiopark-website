---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Agency Partners | Studio Park"
  description="Local production, field teams and content support for agencies bringing campaigns to Western Canada. Work with Studio Park on the ground and through delivery."
>

  <!-- NAV -->
  <nav class="fixed top-0 left-0 right-0 z-50 px-6 md:px-10 py-3 flex items-center justify-between" style="background: linear-gradient(to bottom, rgba(19,17,16,0.92), rgba(19,17,16,0)); backdrop-filter: blur(10px);">
    <a href="/" class="flex items-center gap-3">
      <img src="/studiopark-logo.png" alt="Studio Park" class="logo-mark h-22 md:h-28 w-auto" />
    </a>
    <ul class="hidden md:flex items-center gap-8 text-[15px]" style="color: var(--cream);">
      <li><a href="/work" class="nav-link">Work</a></li>
      <li><a href="/capabilities" class="nav-link">Capabilities</a></li>
      <li><a href="/about" class="nav-link">About</a></li>
      <li><a href="/agency-partners" class="nav-link active">Agency Partners</a></li>
      <li><a href="/contact" class="nav-link">Let's Chat</a></li>
    </ul>
    <div class="hidden md:flex items-center gap-3 text-xs mono" style="color: var(--cream-dim);">
      YYC
    </div>
  </nav>

  <!-- HERO -->
  <section class="relative px-6 md:px-10 pt-36 md:pt-48 pb-10 overflow-hidden">
    <div class="flex items-start justify-between mb-14 md:mb-20">
      <div class="rise" style="animation-delay: 0.1s;">
        <div class="label mb-2">§ 01 — Agency Partners</div>
        <div class="label" style="color: var(--cream);">Partnership, not hand-off</div>
      </div>
      <div class="text-right rise" style="animation-delay: 0.2s;">
        <div class="label" style="color: var(--cream);">Agencies &amp; Partners</div>
      </div>
    </div>

    <h1 class="display text-[16vw] md:text-[11.5vw] rise" style="animation-delay: 0.3s;">Your team</h1>
    <h1 class="display text-[16vw] md:text-[11.5vw] rise mt-2 md:mt-3" style="animation-delay: 0.5s;">out West<span class="dot-accent">.</span></h1>

    <p class="mt-8 md:mt-10 text-[15px] leading-relaxed fade-in-up" style="color: var(--cream-dim); max-width: 700px;">
      You know the brand. We know what it takes to deliver here. Studio Park grew through agency partnerships. We work alongside producers, account teams and creatives to bring campaigns into Western Canada — with local planning, people and production support shaped around your brief.
    </p>

    <div class="h-px widen mt-14 md:mt-20" style="background: var(--line); animation-delay: 0.9s;"></div>
  </section>

  <!-- HOW WE SUPPORT YOU -->
  <section class="px-6 md:px-10 py-24 md:py-36 border-t" style="border-color: var(--line);">
    <div class="grid grid-cols-12 gap-6 mb-14 md:mb-20">
      <div class="col-span-12 md:col-span-4">
        <div class="label mb-4">§ 02 — How We Support You</div>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="display-md text-4xl md:text-6xl mb-4 fade-in-up">
          One team around the brief.
        </h2>
        <p class="text-[15px] leading-relaxed max-w-xl fade-in-up" style="color: var(--cream-dim);">
          We scope the work, agree the points of contact, and keep the communication connected to the brief.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14">
      <div class="fade-in-up fade-delay-1">
        <span class="idx text-5xl">01</span>
        <h3 class="display-md text-xl mt-4 mb-3">Local planning</h3>
        <p class="text-[14px] leading-relaxed" style="color: var(--cream-dim);">
          Venues, permits, and practical input before the plan locks.
        </p>
      </div>
      <div class="fade-in-up fade-delay-2">
        <span class="idx text-5xl" style="color: var(--magenta);">02</span>
        <h3 class="display-md text-xl mt-4 mb-3">Production coordination</h3>
        <p class="text-[14px] leading-relaxed" style="color: var(--cream-dim);">
          Suppliers, schedules, logistics, and on-site oversight.
        </p>
      </div>
      <div class="fade-in-up fade-delay-3">
        <span class="idx text-5xl">03</span>
        <h3 class="display-md text-xl mt-4 mb-3">Field teams</h3>
        <p class="text-[14px] leading-relaxed" style="color: var(--cream-dim);">
          Ambassadors, crews, and event captains — recruited, briefed, scheduled.
        </p>
      </div>
      <div class="fade-in-up fade-delay-4">
        <span class="idx text-5xl" style="color: var(--magenta);">04</span>
        <h3 class="display-md text-xl mt-4 mb-3">Content support</h3>
        <p class="text-[14px] leading-relaxed" style="color: var(--cream-dim);">
          Photography, film, and edits for your campaign channels.
        </p>
      </div>
    </div>
  </section>

  <!-- WORKING TOGETHER -->
  <section class="px-6 md:px-10 py-24 md:py-36 border-t" style="border-color: var(--line); background: var(--bg-lift);">
    <div class="grid grid-cols-12 gap-6 mb-10 md:mb-14">
      <div class="col-span-12 md:col-span-4">
        <div class="label mb-4">§ 03 — Working Together</div>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="display-md text-3xl md:text-5xl fade-in-up">
          How we fit alongside your team.
        </h2>
      </div>
    </div>

    <p class="max-w-2xl text-[15px] leading-relaxed fade-in-up" style="color: var(--cream-dim);">
      We scope the work to fit — a single service or several brought together. Roles, communication, and when Studio Park participates in client conversations are all agreed up front.
    </p>
  </section>

  <!-- CTA -->
  <section class="px-6 md:px-10 py-28 md:py-40 relative overflow-hidden border-t" style="border-color: var(--line);">
    <div class="glow absolute inset-0"></div>
    <div class="relative">
      <div class="label mb-6" style="color: var(--accent);">§ 04 — Bring It West</div>
      <h2 class="display text-[12vw] md:text-[9vw]">
        Bringing a campaign west<span class="dot-accent">?</span>
      </h2>
      <p class="mt-8 max-w-xl text-[15px] leading-relaxed" style="color: var(--cream-dim);">
        Send the brief and tell us where you need support.
      </p>
      <div class="mt-10 flex flex-col md:flex-row items-start md:items-center gap-6">
        <a href="/contact" class="btn inline-flex items-center gap-3 text-lg display-md px-8 py-4 border" style="border-color: var(--cream); color: var(--cream);">
          Start a partner conversation
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="/work" class="label nav-link" style="color: var(--cream-dim);">Explore our work →</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="px-6 md:px-10 pt-20 pb-10 border-t" style="border-color: var(--line);">
    <div class="grid grid-cols-12 gap-6 mb-16">
      <div class="col-span-12 md:col-span-5">
        <img src="/studiopark-logo.png" alt="Studio Park" class="logo-mark h-20 w-auto mb-6" />
        <p class="text-[14px] max-w-xs leading-relaxed" style="color: var(--cream-dim);">
          The western branch national agencies were missing. Western-based boots on the ground.
        </p>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="label mb-5">Services</div>
        <ul class="space-y-3 text-sm">
          <li><a href="/work" class="nav-link">Work</a></li>
          <li><a href="/content" class="nav-link">Content</a></li>
          <li><a href="/staffing" class="nav-link">Staffing</a></li>
          <li><a href="/consulting" class="nav-link">Consulting</a></li>
          <li><a href="/agency-partners" class="nav-link">Agency Partners</a></li>
        </ul>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="label mb-5">Connect</div>
        <ul class="space-y-3 text-sm">
          <li><a href="/contact" class="nav-link">Contact</a></li>
          <li><a href="mailto:hello@studiopark.ca" class="nav-link">Email</a></li>
        </ul>
      </div>
      <div class="col-span-12 md:col-span-3">
        <div class="label mb-5">Visit</div>
        <p class="text-[14px] leading-relaxed" style="color: var(--cream-dim);">
          1933 10 Ave SW, #301<br/>Calgary, AB T3C 0K3<br/>Canada
        </p>
      </div>
    </div>
    <div class="h-px mb-8" style="background: var(--line);"></div>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-xs mono" style="color: var(--cream-dim);">
      <div>© 2026 Studio Park Inc. All rights reserved.</div>
      <div class="flex items-center gap-5 flex-wrap">
        <span>51.0447° N · 114.0719° W</span>
        <span>Calgary, Alberta</span>
      </div>
    </div>
  </footer>

</BaseLayout>
