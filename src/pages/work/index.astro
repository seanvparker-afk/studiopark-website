---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LetsChatFooter from '../../components/LetsChatFooter.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);

// Reel poster: fetch the Vimeo thumbnail at build time (same oEmbed approach the
// case-study pages use) so the reel shows a branded poster + click-to-play button
// instead of an always-loaded player with native mobile chrome.
const REEL_VIDEO_ID = '1186594762';
let reelThumbnail: string | null = null;
try {
  const res = await fetch(`https://vimeo.com/api/oembed.json?url=https://vimeo.com/${REEL_VIDEO_ID}&width=1920`);
  if (res.ok) {
    const json = (await res.json()) as { thumbnail_url?: string };
    reelThumbnail = json.thumbnail_url ?? null;
  }
} catch {
  reelThumbnail = null;
}

// Positional layout tuned for the homepage "Selected Work" rhythm.
// With 6 items we paint a 7/5, 4/4/4, then full-width panoramic cadence.
// Any extras after position 5 fall through to a uniform 4-col grid.
type Layout = { span: string; aspect: string };
const layoutFor = (i: number): Layout => {
  switch (i) {
    case 0: return { span: 'md:col-span-7', aspect: 'aspect-[16/11]' };
    case 1: return { span: 'md:col-span-5', aspect: 'aspect-[4/5] md:aspect-auto' };
    case 2:
    case 3:
    case 4: return { span: 'md:col-span-4', aspect: 'aspect-[4/5]' };
    case 5: return { span: 'md:col-span-12', aspect: 'aspect-[16/10] md:aspect-[21/9]' };
    default: return { span: 'md:col-span-4', aspect: 'aspect-[4/5]' };
  }
};
---

<BaseLayout
  title="Experiential Work & Brand Activations | Studio Park"
  description="Explore selected Studio Park projects across live experiences, production, staffing and content, with a clear view of our role in bringing each one to life."
>
  <!-- ===================== NAV ===================== -->
  <nav class="fixed top-0 left-0 right-0 z-50 px-6 md:px-10 py-3 flex items-center justify-between"
       style="background: linear-gradient(to bottom, rgba(19,17,16,0.92), rgba(19,17,16,0)); backdrop-filter: blur(10px);">
    <a href="/" class="flex items-center gap-3">
      <img src="/studiopark-logo.png" alt="Studio Park" class="logo-mark h-22 md:h-28 w-auto" />
    </a>
    <ul class="hidden md:flex items-center gap-8 text-[15px]" style="color: var(--cream);">
      <li><a href="/work" class="nav-link active">Work</a></li>
      <li><a href="/capabilities" class="nav-link">Capabilities</a></li>
      <li><a href="/about" class="nav-link">About</a></li>
      <li><a href="/agency-partners" class="nav-link">Agency Partners</a></li>
      <li><a href="/contact" class="nav-link">Let's Chat</a></li>
    </ul>
    <div class="hidden md:flex items-center gap-3 text-xs mono" style="color: var(--cream-dim);">
      YYC
    </div>
  </nav>

  <!-- ===================== HERO ===================== -->
  <section class="relative px-6 md:px-10 pt-36 md:pt-48 pb-14 md:pb-20">
    <div class="flex items-start justify-between mb-14 md:mb-20">
      <div class="rise" style="animation-delay: 0.1s;">
        <div class="label">§ 01 — Selected Work</div>
      </div>
      <div class="text-right rise" style="animation-delay: 0.2s;">
        <div class="label mb-2">{entries.length.toString().padStart(2, '0')} Case Studies</div>
        <div class="label" style="color: var(--cream);">Western Canada</div>
      </div>
    </div>

    <h1 class="display text-[14vw] md:text-[10vw] rise" style="animation-delay: 0.3s;">
      The work, out in the world<span class="dot-accent">.</span>
    </h1>

    <div class="grid grid-cols-12 gap-6 mt-10 md:mt-14">
      <div class="col-span-12 md:col-span-5">
        <p class="text-[15px] md:text-base leading-relaxed fade-in-up" style="color: var(--cream-dim);">
          A selection of the experiences we've helped bring to life. Explore the settings, the people and the practical work behind each project, from live production and field teams to the content that carries the story forward.
        </p>
      </div>
      <div class="col-span-12 md:col-span-7 flex md:justify-end items-end">
        <div class="mono text-xs flex items-center gap-3" style="color: var(--cream-dim);">
          <span class="h-px w-10" style="background: var(--line);"></span>
          Sorted by recency — newest activations first.
        </div>
      </div>
    </div>

    <div class="h-px widen mt-14 md:mt-20" style="background: var(--line); animation-delay: 0.9s;"></div>
  </section>

  <!-- ===================== REEL VIDEO SECTION ===================== -->
  <section class="relative">
    <div class="px-6 md:px-10 pt-16 md:pt-24 pb-10 md:pb-14 flex items-end justify-between gap-6 flex-wrap">
      <div>
        <div class="label mb-4">§ 02 — Reel / 2025</div>
        <h2 class="display text-4xl md:text-6xl mb-3 fade-in-up">A year, in motion.</h2>
        <p class="text-sm md:text-base max-w-md fade-in-up" style="color: var(--cream-dim);">
          Fifteen activations. Four provinces. Selected moments from 2024 — captured, staffed, and produced by us.
        </p>
      </div>
    </div>
    <div
      class="video-hero relative aspect-[16/9] overflow-hidden"
      data-video-id={REEL_VIDEO_ID}
      data-video-title="Studio Park — 2024 reel"
    >
      <div class="video-hero-still absolute inset-0">
        {reelThumbnail && (
          <img
            src={reelThumbnail}
            alt="Studio Park 2024 reel — selected moments"
            class="absolute inset-0 w-full h-full object-cover"
            style="filter: saturate(0.92) contrast(1.02);"
          />
        )}
        <div class="video-hero-scrim absolute inset-0" style="background: linear-gradient(180deg, rgba(19,17,16,0.45) 0%, rgba(19,17,16,0.10) 35%, rgba(19,17,16,0.65) 100%);"></div>

        <!-- Center play button -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="relative flex items-center justify-center">
            <span class="absolute inset-0 rounded-full pulse-ring" style="background: rgba(213, 68, 32, 0.3); width: 130px; height: 130px;"></span>
            <span class="absolute inset-0 rounded-full pulse-ring" style="background: rgba(213, 68, 32, 0.2); width: 130px; height: 130px; animation-delay: 1.2s;"></span>
            <button
              type="button"
              class="video-hero-play relative w-20 h-20 md:w-28 md:h-28 rounded-full flex items-center justify-center pointer-events-auto"
              style="background: var(--accent); box-shadow: 0 20px 60px rgba(213,68,32,0.35);"
              aria-label="Play Studio Park 2024 reel"
            >
              <svg width="26" height="26" viewBox="0 0 24 24" fill="#F2EDE3" style="margin-left: 4px;">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PORTFOLIO GRID ===================== -->
  <section class="px-6 md:px-10 pb-24 md:pb-36">
    <div class="label mb-10 md:mb-14">§ 03 — Explore the Projects</div>
    <div class="grid grid-cols-12 gap-4 md:gap-5">
      {entries.map((entry, i) => {
        const { span, aspect } = layoutFor(i);
        const img = entry.data.thumbImage ?? entry.data.heroImage;
        return (
          <a
            href={`/work/${entry.id}`}
            class={`col-span-12 ${span} group relative img-wrap ${aspect} block fade-in-up fade-delay-${(i % 6) + 1}`}
          >
            <img src={img} alt={entry.data.heroAlt} />
            <figcaption class="caption absolute bottom-0 left-0 right-0 p-5 md:p-6 flex items-end justify-between gap-4">
              <div>
                <div class="label mb-1">Case / {entry.data.caseNumber}</div>
                <div class="display-md text-lg md:text-xl">{entry.data.title}</div>
                <div class="label mt-2" style="color: var(--cream-dim);">
                  {entry.data.locations.join(' · ')}
                </div>
              </div>
              <div class="mono text-xs hidden md:block" style="color: var(--cream-dim);">
                {entry.data.year}
              </div>
            </figcaption>
          </a>
        );
      })}
    </div>
  </section>

  <LetsChatFooter />

  <!-- ===================== FOOTER ===================== -->
  <footer class="px-6 md:px-10 pt-20 pb-10 border-t" style="border-color: var(--line);">
    <div class="grid grid-cols-12 gap-6 mb-16">
      <div class="col-span-12 md:col-span-5">
        <img src="/studiopark-logo.png" alt="Studio Park" class="logo-mark h-20 w-auto mb-6" />
        <p class="text-[14px] max-w-xs leading-relaxed" style="color: var(--cream-dim);">
          The western branch national agencies were missing. Western-based boots on the ground.
        </p>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="label mb-5">Services</div>
        <ul class="space-y-3 text-sm">
          <li><a href="/work" class="nav-link">Work</a></li>
          <li><a href="/content" class="nav-link">Content</a></li>
          <li><a href="/staffing" class="nav-link">Staffing</a></li>
          <li><a href="/consulting" class="nav-link">Consulting</a></li>
        </ul>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="label mb-5">Connect</div>
        <ul class="space-y-3 text-sm">
          <li><a href="/contact" class="nav-link">Contact</a></li>
          <li><a href="mailto:hello@studiopark.ca" class="nav-link">Email</a></li>
        </ul>
      </div>
      <div class="col-span-12 md:col-span-3">
        <div class="label mb-5">Visit</div>
        <p class="text-[14px] leading-relaxed" style="color: var(--cream-dim);">
          1933 10 Ave SW, #301<br/>Calgary, AB T3C 0K3<br/>Canada
        </p>
      </div>
    </div>
    <div class="h-px mb-8" style="background: var(--line);"></div>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-xs mono" style="color: var(--cream-dim);">
      <div>© 2026 Studio Park Inc. All rights reserved.</div>
      <div class="flex items-center gap-5 flex-wrap">
        <span>51.0447° N · 114.0719° W</span>
        <span>Calgary, Alberta</span>
      </div>
    </div>
  </footer>

<style>
  /* Reel click-to-play poster (same pattern as the homepage/case-study hero) */
  .video-hero {
    cursor: pointer;
  }
  .video-hero-still {
    transition: opacity 0.3s ease;
  }
  .video-hero-play,
  .video-hero-scrim {
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                background 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .video-hero:hover .video-hero-play {
    transform: scale(1.05);
  }
  .video-hero:hover .video-hero-scrim {
    background: linear-gradient(180deg, rgba(19,17,16,0.30) 0%, rgba(19,17,16,0.05) 35%, rgba(19,17,16,0.55) 100%);
  }
</style>

<script is:inline>
  document.querySelectorAll('.video-hero[data-video-id]').forEach((hero) => {
    const videoId = hero.getAttribute('data-video-id');
    const videoTitle = hero.getAttribute('data-video-title') || 'Studio Park reel';
    const still = hero.querySelector('.video-hero-still');
    if (!videoId || !still) return;

    let played = false;
    const play = (e) => {
      if (e && e.target.closest('a')) return;
      if (played) return;
      played = true;

      // JS-created elements don't get Astro's scoped cid attributes, so style the
      // iframe inline rather than via a class rule.
      const iframe = document.createElement('iframe');
      iframe.src = 'https://player.vimeo.com/video/' + videoId + '?autoplay=1&title=0&byline=0&portrait=0&badge=0&autopause=0&player_id=0&app_id=58479';
      iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share');
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      iframe.setAttribute('title', videoTitle);
      iframe.setAttribute('frameborder', '0');
      iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:0;';

      hero.insertBefore(iframe, still);

      still.style.opacity = '0';
      still.style.pointerEvents = 'none';
      hero.style.cursor = 'default';

      setTimeout(() => {
        still.style.visibility = 'hidden';
      }, 300);
    };

    hero.addEventListener('click', play);
  });
</script>
</BaseLayout>
