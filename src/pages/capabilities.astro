---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Capabilities | Studio Park"
  description="Production, content and field teams from Studio Park. Three integrated services for brand experiences across Western Canada."
>

  <!-- NAV -->
  <nav class="fixed top-0 left-0 right-0 z-50 px-6 md:px-10 py-3 flex items-center justify-between" style="background: linear-gradient(to bottom, rgba(19,17,16,0.92), rgba(19,17,16,0)); backdrop-filter: blur(10px);">
    <a href="/" class="flex items-center gap-3">
      <img src="/studiopark-logo.png" alt="Studio Park" class="logo-mark h-22 md:h-28 w-auto" />
    </a>
    <ul class="hidden md:flex items-center gap-8 text-[15px]" style="color: var(--cream);">
      <li><a href="/work" class="nav-link">Work</a></li>
      <li><a href="/capabilities" class="nav-link active">Capabilities</a></li>
      <li><a href="/about" class="nav-link">About</a></li>
      <li><a href="/agency-partners" class="nav-link">Agency Partners</a></li>
      <li><a href="/contact" class="nav-link">Let's Chat</a></li>
    </ul>
    <div class="hidden md:flex items-center gap-3 text-xs mono" style="color: var(--cream-dim);">
      YYC
    </div>
  </nav>

  <!-- HERO -->
  <section class="relative px-6 md:px-10 pt-36 md:pt-48 pb-10 overflow-hidden">
    <div class="rise" style="animation-delay: 0.1s;">
      <div class="label mb-14 md:mb-20">§ 01 — Capabilities</div>
    </div>

    <h1 class="display text-[13vw] md:text-[9vw] rise" style="animation-delay: 0.3s;">The thinking. The people.</h1>
    <h1 class="display text-[13vw] md:text-[9vw] rise mt-2 md:mt-3" style="animation-delay: 0.5s;">The follow-through<span class="dot-accent">.</span></h1>

    <p class="mt-8 md:mt-10 max-w-xl text-[15px] leading-relaxed rise" style="color: var(--cream-dim); animation-delay: 0.7s;">
      Bring us the challenge, the brief or the idea already taking shape. We'll bring together the team and the plan to move it forward.
    </p>

    <div class="h-px widen mt-14 md:mt-20" style="background: var(--line); animation-delay: 0.9s;"></div>

    <div class="flex items-center justify-center mt-10 rise" style="animation-delay: 1.1s;">
      <div class="flex items-center gap-2 nudge">
        <div class="label">Scroll</div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#A69E91" stroke-width="1.5">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="px-6 md:px-10 py-24 md:py-36 border-t" style="border-color: var(--line);">
    <div class="grid grid-cols-12 gap-6 mb-14 md:mb-20">
      <div class="col-span-12 md:col-span-4">
        <div class="label mb-4">§ 02 — Three Integrated Services</div>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="display-md text-4xl md:text-6xl">
          One team, scoped to the brief.
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-5">

      <article class="group">
        <div class="img-wrap aspect-[4/5] mb-6">
          <img
            src="https://static.wixstatic.com/media/81231b_f938854487ab41fba46ca7431ee726e2~mv2.jpg/v1/fit/w_900,h_1125,q_90,enc_avif,quality_auto/file.jpg"
            alt="Consulting and logistics"
          />
        </div>
        <div class="flex items-baseline justify-between mb-4">
          <span class="idx text-4xl">01</span>
          <span class="label">Navigate</span>
        </div>
        <h3 class="display-md text-2xl md:text-3xl mb-3">Production &amp; Delivery</h3>
        <p class="text-[15px] leading-relaxed" style="color: var(--cream-dim);">
          From venues and suppliers to schedules and on-site decisions, we coordinate the work that turns a plan into a live experience.
        </p>
        <a href="/consulting" class="inline-flex items-center gap-2 mt-6 text-sm nav-link">
          See the playbook <span>→</span>
        </a>
      </article>

      <article class="group md:mt-16">
        <div class="img-wrap aspect-[4/5] mb-6">
          <img
            src="https://static.wixstatic.com/media/506540_f6e16f054d944fc89c561bd789c3749c~mv2.jpg/v1/fit/w_900,h_1125,q_90,enc_avif,quality_auto/file.jpg"
            alt="Content production"
          />
        </div>
        <div class="flex items-baseline justify-between mb-4">
          <span class="idx text-4xl" style="color: var(--magenta);">02</span>
          <span class="label">Capture</span>
        </div>
        <h3 class="display-md text-2xl md:text-3xl mb-3">Content Production</h3>
        <p class="text-[15px] leading-relaxed" style="color: var(--cream-dim);">
          Photography, film and social-ready edits that give the experience a life beyond the event.
        </p>
        <a href="/content" class="inline-flex items-center gap-2 mt-6 text-sm nav-link">
          Explore content <span>→</span>
        </a>
      </article>

      <article class="group md:mt-8">
        <div class="img-wrap aspect-[4/5] mb-6">
          <img
            src="https://static.wixstatic.com/media/506540_8f409386c79241a09b85b753d035c24e~mv2.jpg/v1/fit/w_900,h_1125,q_90,enc_avif,quality_auto/file.jpg"
            alt="Talent and staffing"
          />
        </div>
        <div class="flex items-baseline justify-between mb-4">
          <span class="idx text-4xl">03</span>
          <span class="label">Represent</span>
        </div>
        <h3 class="display-md text-2xl md:text-3xl mb-3">Brand Ambassadors &amp; Field Management</h3>
        <p class="text-[15px] leading-relaxed" style="color: var(--cream-dim);">
          The people your audience meets matter. We bring together ambassadors, event crews and on-site leads, prepared for the brand and the brief.
        </p>
        <a href="/staffing" class="inline-flex items-center gap-2 mt-6 text-sm nav-link">
          Meet the roster <span>→</span>
        </a>
      </article>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="px-6 md:px-10 py-24 md:py-36 border-t" style="border-color: var(--line);">
    <div class="grid grid-cols-12 gap-6 mb-14 md:mb-20">
      <div class="col-span-12 md:col-span-4">
        <div class="label mb-4">§ 03 — How We Work</div>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="display-md text-4xl md:text-6xl">
          From brief to load-out,<br/>
          <span style="color: var(--cream-dim);">without surprises.</span>
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t" style="border-color: var(--line);">
      <div class="p-6 md:p-10 md:border-r" style="border-color: var(--line);">
        <div class="flex items-center gap-4 mb-6">
          <span class="idx text-5xl">01</span>
          <span class="h-px flex-1 grow-line" style="background: var(--accent);"></span>
        </div>
        <h3 class="display-md text-xl md:text-2xl mb-4">Inquiry &amp; Alignment</h3>
        <p class="text-[15px] leading-relaxed" style="color: var(--cream-dim);">
          Objectives, markets, timelines, on-site requirements. We align before the clock starts so nothing slips between strategy and execution.
        </p>
      </div>
      <div class="p-6 md:p-10 md:border-r" style="border-color: var(--line);">
        <div class="flex items-center gap-4 mb-6">
          <span class="idx text-5xl">02</span>
          <span class="h-px flex-1 grow-line" style="background: var(--accent); animation-delay: 0.6s;"></span>
        </div>
        <h3 class="display-md text-xl md:text-2xl mb-4">Planning &amp; Coordination</h3>
        <p class="text-[15px] leading-relaxed" style="color: var(--cream-dim);">
          Staffing, permitting, venues, run-of-show, content needs. Your local producers anticipating what the deck didn't cover.
        </p>
      </div>
      <div class="p-6 md:p-10">
        <div class="flex items-center gap-4 mb-6">
          <span class="idx text-5xl">03</span>
          <span class="h-px flex-1 grow-line" style="background: var(--accent); animation-delay: 0.9s;"></span>
        </div>
        <h3 class="display-md text-xl md:text-2xl mb-4">On-Site Execution</h3>
        <p class="text-[15px] leading-relaxed" style="color: var(--cream-dim);">
          Load-in to load-out. Talent, guest flow, brand standards, content capture, live troubleshooting. Your brief, delivered with pride.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 md:px-10 py-28 md:py-40 relative overflow-hidden border-t" style="border-color: var(--line);">
    <div class="glow absolute inset-0"></div>
    <div class="relative">
      <div class="label mb-6" style="color: var(--accent);">§ 04 — What's the Brief?</div>
      <h2 class="display text-[12vw] md:text-[9vw]">
        Tell us what you're building<span class="dot-accent">.</span>
      </h2>
      <p class="mt-8 max-w-xl text-[15px] leading-relaxed" style="color: var(--cream-dim);">
        Send the brief, the rough date, and the problem you're trying to solve.
      </p>
      <div class="mt-10 flex flex-col md:flex-row items-start md:items-center gap-6">
        <a href="/contact" class="btn inline-flex items-center gap-3 text-lg display-md px-8 py-4 border" style="border-color: var(--cream); color: var(--cream);">
          Start a conversation
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="/work" class="label nav-link" style="color: var(--cream-dim);">Explore our work →</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="px-6 md:px-10 pt-20 pb-10 border-t" style="border-color: var(--line);">
    <div class="grid grid-cols-12 gap-6 mb-16">
      <div class="col-span-12 md:col-span-5">
        <img src="/studiopark-logo.png" alt="Studio Park" class="logo-mark h-20 w-auto mb-6" />
        <p class="text-[14px] max-w-xs leading-relaxed" style="color: var(--cream-dim);">
          The western branch national agencies were missing. Western-based boots on the ground.
        </p>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="label mb-5">Services</div>
        <ul class="space-y-3 text-sm">
          <li><a href="/work" class="nav-link">Work</a></li>
          <li><a href="/content" class="nav-link">Content</a></li>
          <li><a href="/staffing" class="nav-link">Staffing</a></li>
          <li><a href="/consulting" class="nav-link">Consulting</a></li>
        </ul>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="label mb-5">Connect</div>
        <ul class="space-y-3 text-sm">
          <li><a href="/contact" class="nav-link">Contact</a></li>
          <li><a href="mailto:hello@studiopark.ca" class="nav-link">Email</a></li>
        </ul>
      </div>
      <div class="col-span-12 md:col-span-3">
        <div class="label mb-5">Visit</div>
        <p class="text-[14px] leading-relaxed" style="color: var(--cream-dim);">
          1933 10 Ave SW, #301<br/>Calgary, AB T3C 0K3<br/>Canada
        </p>
      </div>
    </div>
    <div class="h-px mb-8" style="background: var(--line);"></div>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-xs mono" style="color: var(--cream-dim);">
      <div>© 2026 Studio Park Inc. All rights reserved.</div>
      <div class="flex items-center gap-5 flex-wrap">
        <span>51.0447° N · 114.0719° W</span>
        <span>Calgary, Alberta</span>
      </div>
    </div>
  </footer>

</BaseLayout>
