---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetsChatFooter from '../components/LetsChatFooter.astro';
---

<BaseLayout
  title="About | Studio Park"
  description="Studio Park is a Calgary-based experiential agency. Built on agency partnerships, now helping brands create live experiences across Western Canada."
>

  <!-- NAV -->
  <nav class="fixed top-0 left-0 right-0 z-50 px-6 md:px-10 py-3 flex items-center justify-between" style="background: linear-gradient(to bottom, rgba(19,17,16,0.92), rgba(19,17,16,0)); backdrop-filter: blur(10px);">
    <a href="/" class="flex items-center gap-3">
      <img src="/studiopark-logo.png" alt="Studio Park" class="logo-mark h-22 md:h-28 w-auto" />
    </a>
    <ul class="hidden md:flex items-center gap-8 text-[15px]" style="color: var(--cream);">
      <li><a href="/work" class="nav-link">Work</a></li>
      <li><a href="/capabilities" class="nav-link">Capabilities</a></li>
      <li><a href="/about" class="nav-link active">About</a></li>
      <li><a href="/agency-partners" class="nav-link">Agency Partners</a></li>
      <li><a href="/contact" class="nav-link">Let's Chat</a></li>
    </ul>
    <div class="hidden md:flex items-center gap-3 text-xs mono" style="color: var(--cream-dim);">
      YYC
    </div>
  </nav>

  <!-- HERO -->
  <section class="relative px-6 md:px-10 pt-36 md:pt-48 pb-10 overflow-hidden">
    <div class="rise" style="animation-delay: 0.1s;">
      <div class="label mb-14 md:mb-20">§ 01 — About</div>
    </div>

    <h1 class="display text-[16vw] md:text-[11vw] rise" style="animation-delay: 0.3s;">Built in Calgary.</h1>
    <h1 class="display text-[16vw] md:text-[11vw] rise mt-2 md:mt-3" style="animation-delay: 0.5s;">Shaped by the work<span class="dot-accent">.</span></h1>

    <p class="mt-8 md:mt-10 max-w-xl text-[15px] leading-relaxed fade-in-up" style="color: var(--cream-dim);">
      Studio Park grew from a simple need: agencies needed a team they could count on when their campaigns came west. Today, we're building on that foundation to help brands create experiences from the first conversation to the final guest.
    </p>

    <div class="h-px widen mt-14 md:mt-20" style="background: var(--line); animation-delay: 0.9s;"></div>

    <div class="flex items-center justify-center mt-10 rise" style="animation-delay: 1.1s;">
      <div class="flex items-center gap-2 nudge">
        <div class="label">Scroll</div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#A69E91" stroke-width="1.5">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- HOW WE GOT HERE -->
  <section class="px-6 md:px-10 py-24 md:py-36 border-t" style="border-color: var(--line);">
    <div class="max-w-2xl">
      <div class="label mb-4">§ 02 — How We Got Here</div>
      <h2 class="display-md text-3xl md:text-5xl mb-8 fade-in-up">
        A team built on delivery.
      </h2>
      <p class="text-[15px] leading-relaxed mb-5 fade-in-up" style="color: var(--cream-dim);">
        That experience shaped how we work. Understand the brief. Bring the right people together. Pay attention to the details. Take responsibility for delivery.
      </p>
      <p class="text-[15px] leading-relaxed fade-in-up" style="color: var(--cream-dim);">
        Today, we're a team of producers, field leads and content creators based in Calgary, working across Western Canada to bring brand experiences to life.
      </p>
    </div>
  </section>

  <!-- TRUSTED BY -->
  <section class="py-20 border-t" style="border-color: var(--line);">
    <div class="px-6 md:px-10 mb-14 md:mb-20">
      <h2 class="display text-5xl md:text-7xl fade-in-up">
        Trusted by<span class="dot-accent">.</span>
      </h2>
    </div>

    <div class="client-marquee overflow-hidden">
      <div class="flex marquee-track marquee-track--slow whitespace-nowrap">
        <div class="flex items-center gap-x-16 md:gap-x-28 pr-16 md:pr-28 shrink-0">
          <img src="/clients/mosaic.png" alt="Mosaic" class="invert-cream h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 0ms;" />
          <img src="/clients/platform-calgary.png" alt="Platform Calgary" class="h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 50ms;" />
          <img src="/clients/creative-destruction-labs.png" alt="Creative Destruction Labs" class="invert-cream h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 100ms;" />
          <img src="/clients/banded-peak-brewing.png" alt="Banded Peak Brewing" class="h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 150ms;" />
          <img src="/clients/calgary-winter-club.png" alt="Calgary Winter Club" class="invert-cream h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 200ms;" />
          <img src="/clients/abf.png" alt="Alberta Beer Festivals" class="invert-cream h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 250ms;" />
          <img src="/clients/ecd.png" alt="ECD" class="h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 300ms;" />
          <img src="/clients/bearhill.png" alt="Bear Hill Brewing" class="h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 350ms;" />
          <img src="/clients/midnight-circus.png" alt="Midnight Circus" class="h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 400ms;" />
          <img src="/clients/armstrong.png" alt="Armstrong" class="h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 450ms;" />
          <img src="/clients/sdi-mktg.png" alt="SDI Marketing" class="invert-cream h-24 md:h-24 w-auto object-contain shrink-0 fade-in-up" style="transition-delay: 500ms;" />
        </div>
        <div class="flex items-center gap-x-16 md:gap-x-28 pr-16 md:pr-28 shrink-0" aria-hidden="true">
          <img src="/clients/mosaic.png" alt="" class="invert-cream h-24 md:h-24 w-auto object-contain shrink-0" />
          <img src="/clients/platform-calgary.png" alt="" class="h-24 md:h-24 w-auto object-contain shrink-0" />
          <img src="/clients/creative-destruction-labs.png" alt="" class="invert-cream h-24 md:h-24 w-auto object-contain shrink-0" />
          <img src="/clients/banded-peak-brewing.png" alt="" class="h-24 md:h-24 w-auto object-contain shrink-0" />
          <img src="/clients/calgary-winter-club.png" alt="" class="invert-cream h-24 md:h-24 w-auto object-contain shrink-0" />
          <img src="/clients/abf.png" alt="" class="invert-cream h-24 md:h-24 w-auto object-contain shrink-0" />
          <img src="/clients/ecd.png" alt="" class="h-24 md:h-24 w-auto object-contain shrink-0" />
          <img src="/clients/bearhill.png" alt="" class="h-24 md:h-24 w-auto object-contain shrink-0" />
          <img src="/clients/midnight-circus.png" alt="" class="h-24 md:h-24 w-auto object-contain shrink-0" />
          <img src="/clients/armstrong.png" alt="" class="h-24 md:h-24 w-auto object-contain shrink-0" />
          <img src="/clients/sdi-mktg.png" alt="" class="invert-cream h-24 md:h-24 w-auto object-contain shrink-0" />
        </div>
      </div>
    </div>
  </section>

  <LetsChatFooter />

  <!-- FOOTER -->
  <footer class="px-6 md:px-10 pt-20 pb-10 border-t" style="border-color: var(--line);">
    <div class="grid grid-cols-12 gap-6 mb-16">
      <div class="col-span-12 md:col-span-5">
        <img src="/studiopark-logo.png" alt="Studio Park" class="logo-mark h-20 w-auto mb-6" />
        <p class="text-[14px] max-w-xs leading-relaxed" style="color: var(--cream-dim);">
          The western branch national agencies were missing. Western-based boots on the ground.
        </p>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="label mb-5">Services</div>
        <ul class="space-y-3 text-sm">
          <li><a href="/work" class="nav-link">Work</a></li>
          <li><a href="/content" class="nav-link">Content</a></li>
          <li><a href="/staffing" class="nav-link">Staffing</a></li>
          <li><a href="/consulting" class="nav-link">Consulting</a></li>
        </ul>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="label mb-5">Connect</div>
        <ul class="space-y-3 text-sm">
          <li><a href="/contact" class="nav-link">Contact</a></li>
          <li><a href="mailto:hello@studiopark.ca" class="nav-link">Email</a></li>
        </ul>
      </div>
      <div class="col-span-12 md:col-span-3">
        <div class="label mb-5">Visit</div>
        <p class="text-[14px] leading-relaxed" style="color: var(--cream-dim);">
          1933 10 Ave SW, #301<br/>Calgary, AB T3C 0K3<br/>Canada
        </p>
      </div>
    </div>
    <div class="h-px mb-8" style="background: var(--line);"></div>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-xs mono" style="color: var(--cream-dim);">
      <div>© 2026 Studio Park Inc. All rights reserved.</div>
      <div class="flex items-center gap-5 flex-wrap">
        <span>51.0447° N · 114.0719° W</span>
        <span>Calgary, Alberta</span>
      </div>
    </div>
  </footer>

</BaseLayout>
