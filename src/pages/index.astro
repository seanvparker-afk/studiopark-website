---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// §05 "Selected Work" — six real case studies in a curated editorial order.
// Title / image / year come from each case's frontmatter; only the span + aspect
// rhythm is authored here (portrait items stay aspect-[4/5] on mobile, landscape
// items go wide from md: up).
const caseData = Object.fromEntries(
  (await getCollection('work')).map((e) => [e.id, e.data])
);
const featuredWork = [
  { slug: 'calgary-stampede', span: 'md:col-span-7', aspect: 'aspect-[4/5] md:aspect-[16/11]' },
  { slug: 'rose-disco',       span: 'md:col-span-5', aspect: 'aspect-[4/5] md:aspect-auto' },
  { slug: 'abf',              span: 'md:col-span-4', aspect: 'aspect-[4/5]' },
  { slug: 'harvest-house',    span: 'md:col-span-4', aspect: 'aspect-[4/5]' },
  { slug: 'scream',           span: 'md:col-span-4', aspect: 'aspect-[4/5]' },
  { slug: 'the-cup',          span: 'md:col-span-5', aspect: 'aspect-[4/5] md:aspect-auto' },
].map((f) => ({ ...f, data: caseData[f.slug] }));
---

<BaseLayout title="Studio Park — Western Canada's experiential production partner">

  <!-- ===================== NAV ===================== -->
  <nav class="fixed top-0 left-0 right-0 z-50 px-6 md:px-10 py-3 flex items-center justify-between"
       style="background: linear-gradient(to bottom, rgba(19,17,16,0.92), rgba(19,17,16,0)); backdrop-filter: blur(10px);">
    <a href="/" class="flex items-center gap-3">
      <img src="/studiopark-logo.png" alt="Studio Park" class="logo-mark h-22 md:h-28 w-auto" />
    </a>
    <ul class="hidden md:flex items-center gap-8 text-[15px]" style="color: var(--cream);">
      <li><a href="/work" class="nav-link">Work</a></li>
      <li><a href="/capabilities" class="nav-link">Capabilities</a></li>
      <li><a href="/about" class="nav-link">About</a></li>
      <li><a href="/agency-partners" class="nav-link">Agency Partners</a></li>
      <li><a href="/contact" class="nav-link">Let's Chat</a></li>
    </ul>
    <div class="hidden md:flex items-center gap-3 text-xs mono" style="color: var(--cream-dim);">
      YYC
    </div>
  </nav>

  <!-- ===================== HERO ===================== -->
  <section class="relative px-6 md:px-10 pt-36 md:pt-48 pb-10 overflow-hidden">
    <!-- Display headline -->
    <div class="flex items-end justify-between gap-8 mt-14 md:mt-20">
      <h1 class="display text-[13vw] md:text-[10vw] rise" style="animation-delay: 0.3s;">
        Make your brand felt<span class="dot-accent">.</span>
      </h1>
      <p class="hidden md:block max-w-sm text-[26px] leading-relaxed pb-5 fade-in-up" style="color: var(--cream-dim);">
        Studio Park is an experiential agency based in Calgary. We bring ideas, production, people and content together to create brand experiences worth being part of.
      </p>
    </div>

    <!-- Mobile description -->
    <p class="md:hidden mt-6 text-[18px] leading-relaxed fade-in-up" style="color: var(--cream-dim);">
      Studio Park is an experiential agency based in Calgary. We bring ideas, production, people and content together to create brand experiences worth being part of.
    </p>

    <!-- Divider -->
    <div class="h-px widen mt-14 md:mt-20" style="background: var(--line); animation-delay: 0.9s;"></div>

    <!-- Hero image row -->
    <div class="grid grid-cols-12 gap-4 md:gap-5 mt-10 md:mt-12 rise" style="animation-delay: 1.1s;">
      <div class="col-span-12 md:col-span-8 img-wrap aspect-[4/5] md:aspect-[16/9]">
        <img
          src="https://static.wixstatic.com/media/506540_f339de76671e4dd3b9183c26d007cc0d~mv2.jpg/v1/fit/w_1600,h_1067,q_90,enc_avif,quality_auto/506540_f339de76671e4dd3b9183c26d007cc0d~mv2.jpg"
          alt="Studio Park activation — Calgary"
        />
      </div>
      <div class="col-span-12 md:col-span-4 flex flex-col justify-between gap-4 md:gap-5">
        <div class="img-wrap aspect-[4/5] flex-1 hidden md:block">
          <img
            src="https://static.wixstatic.com/media/506540_af9f6f7bfa9e49feaad0324b5643d6bf~mv2.jpg/v1/fit/w_800,h_1000,q_90,enc_avif,quality_auto/file.jpg"
            alt="Event talent"
          />
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 nudge">
            <div class="label">Scroll</div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#A69E91" stroke-width="1.5">
              <path d="M12 5v14M5 12l7 7 7-7"/>
            </svg>
          </div>
          <div class="mono text-xs" style="color: var(--cream-dim);">001 / 006</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="px-6 md:px-10 py-24 md:py-36">
    <div class="mb-14 md:mb-20">
      <div class="label mb-8 md:mb-12 fade-in-up">§ 02 — Capabilities</div>
      <h2
        class="display text-[clamp(36px,11vw,64px)] md:text-[clamp(80px,14vw,240px)] leading-[0.9] tracking-[-0.03em] fade-in-up"
        style="color: var(--cream); font-weight: 800;"
      >
        The thinking. The people.<br/>The follow-through.
      </h2>
      <p class="mt-8 md:mt-10 text-[15px] leading-relaxed max-w-xl fade-in-up" style="color: var(--cream-dim);">
        Bring us the challenge, the brief or the idea already taking shape. We'll bring together the team and the plan to move it forward.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-5">

      <article class="group fade-in-up fade-delay-1">
        <div class="img-wrap aspect-[4/5] mb-6">
          <img
            src="https://static.wixstatic.com/media/81231b_f938854487ab41fba46ca7431ee726e2~mv2.jpg/v1/fit/w_900,h_1125,q_90,enc_avif,quality_auto/file.jpg"
            alt="Consulting and logistics"
          />
        </div>
        <div class="flex items-baseline justify-between mb-4">
          <span class="idx text-4xl">01</span>
          <span class="label">Navigate</span>
        </div>
        <h3 class="display-md text-2xl md:text-3xl mb-3">Production &amp; delivery</h3>
        <p class="text-[15px] leading-relaxed" style="color: var(--cream-dim);">
          From venues and suppliers to schedules and on-site decisions, we coordinate the work that turns a plan into a live experience.
        </p>
        <a href="/consulting" class="inline-flex items-center gap-2 mt-6 text-sm nav-link">
          See the playbook <span>→</span>
        </a>
      </article>

      <article class="group md:mt-16 fade-in-up fade-delay-2">
        <div class="img-wrap aspect-[4/5] mb-6">
          <img
            src="https://static.wixstatic.com/media/506540_f6e16f054d944fc89c561bd789c3749c~mv2.jpg/v1/fit/w_900,h_1125,q_90,enc_avif,quality_auto/file.jpg"
            alt="Content production"
          />
        </div>
        <div class="flex items-baseline justify-between mb-4">
          <span class="idx text-4xl" style="color: var(--magenta);">02</span>
          <span class="label">Capture</span>
        </div>
        <h3 class="display-md text-2xl md:text-3xl mb-3">Content production</h3>
        <p class="text-[15px] leading-relaxed" style="color: var(--cream-dim);">
          Photography, film and social-ready edits that give the experience a life beyond the event.
        </p>
        <a href="/content" class="inline-flex items-center gap-2 mt-6 text-sm nav-link">
          Explore content <span>→</span>
        </a>
      </article>

      <article class="group md:mt-8 fade-in-up fade-delay-3">
        <div class="img-wrap aspect-[4/5] mb-6">
          <img
            src="https://static.wixstatic.com/media/506540_8f409386c79241a09b85b753d035c24e~mv2.jpg/v1/fit/w_900,h_1125,q_90,enc_avif,quality_auto/file.jpg"
            alt="Talent and staffing"
          />
        </div>
        <div class="flex items-baseline justify-between mb-4">
          <span class="idx text-4xl">03</span>
          <span class="label">Represent</span>
        </div>
        <h3 class="display-md text-2xl md:text-3xl mb-3">Brand Ambassadors &amp; Field Management</h3>
        <p class="text-[15px] leading-relaxed" style="color: var(--cream-dim);">
          The people your audience meets matter. We bring together ambassadors, event crews and on-site leads, prepared for the brand and the brief.
        </p>
        <a href="/staffing" class="inline-flex items-center gap-2 mt-6 text-sm nav-link">
          Meet the roster <span>→</span>
        </a>
      </article>
    </div>
  </section>

  <!-- ===================== AGENCY PARTNERS TEASER ===================== -->
  <section class="px-6 md:px-10 py-24 md:py-32 border-y" style="border-color: var(--line); background: var(--bg-lift);">
    <div class="grid grid-cols-12 gap-10 md:gap-16 items-center">
      <div class="col-span-12 md:col-span-6">
        <div class="label mb-4">§ 03 — Agency Partners</div>
        <h2 class="display-md text-3xl md:text-5xl mb-6 fade-in-up">
          Still your team out West.
        </h2>
        <p class="text-[15px] leading-relaxed mb-10 fade-in-up" style="color: var(--cream-dim);">
          Our business grew through agency partnerships, and those relationships remain central to how we work. When your activation comes west, we bring local production knowledge, field teams and content support to help you deliver.
        </p>
        <a href="/agency-partners" class="btn inline-flex items-center gap-3 text-lg display-md px-8 py-4 border" style="border-color: var(--cream); color: var(--cream);">
          Work with us out West
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="col-span-12 md:col-span-6">
        <div class="img-wrap aspect-[4/5]">
          <img
            src="https://static.wixstatic.com/media/81231b_b60c285db05f4ee697d705a09849d015~mv2.jpg/v1/fit/w_1200,h_1500,q_90,enc_avif,quality_auto/file.jpg"
            alt="Cowboys Music Festival crowd moment — Calgary Stampede"
          />
        </div>
        <p class="mono text-xs mt-3" style="color: var(--cream-dim); letter-spacing: 0.08em;">
          ON-SITE — CALGARY STAMPEDE, 2024
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== PULL QUOTE ===================== -->
  <section class="px-6 md:px-10 py-24 md:py-32 border-y" style="border-color: var(--line); background: var(--bg-lift);">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-3 mb-10">
        <span class="dot-accent text-2xl">❝</span>
        <span class="label">Client testimony</span>
      </div>
      <p class="pullquote text-3xl md:text-5xl fade-in-up">
        "It was amazing working with the Studio Park team. I'd recommend them to elevate any activation."
      </p>
      <div class="mt-12 flex items-baseline gap-6">
        <span class="h-px flex-shrink-0 w-12" style="background: var(--accent);"></span>
        <div>
          <div class="display-md text-lg">Kayla-Rae Maurer</div>
          <div class="label mt-1">Agency Partner</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MANIFESTO ===================== -->
  <section class="px-6 md:px-10 py-24 md:py-36 overflow-hidden">
    <div class="label mb-8 md:mb-12 fade-in-up">§ 04 — The Work</div>
    <h2
      class="display uppercase text-[clamp(36px,11vw,64px)] md:text-[clamp(80px,14vw,240px)] leading-[0.9] tracking-[-0.03em] fade-in-up"
      style="color: var(--cream-dim); font-weight: 800;"
    >
      Experiences that<br/>make brands felt.
    </h2>

    <div class="grid grid-cols-12 gap-6 md:gap-10 mt-14 md:mt-20">
      <div class="col-span-12 md:col-span-8 md:col-start-5">
        <div class="label mb-6 fade-in-up">What We Bring</div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 md:gap-6">
          <div class="fade-in-up fade-delay-1">
            <div class="label mb-4" style="color: var(--cream);">Ideas</div>
            <ul class="space-y-2 text-base md:text-lg">
              <li>Brand strategy</li>
              <li>Audience planning</li>
              <li>Experience design</li>
            </ul>
          </div>
          <div class="fade-in-up fade-delay-2">
            <div class="label mb-4" style="color: var(--cream);">Production</div>
            <ul class="space-y-2 text-base md:text-lg">
              <li>Venues &amp; permits</li>
              <li>Suppliers &amp; logistics</li>
              <li>Live delivery</li>
            </ul>
          </div>
          <div class="fade-in-up fade-delay-3">
            <div class="label mb-4" style="color: var(--cream);">People &amp; Content</div>
            <ul class="space-y-2 text-base md:text-lg">
              <li>Field teams</li>
              <li>Photography &amp; film</li>
              <li>Social content</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WORK / PORTFOLIO ===================== -->
  <section id="work" class="px-6 md:px-10 py-24 md:py-36">
    <div class="flex items-end justify-between mb-14 md:mb-20 flex-wrap gap-6">
      <div>
        <div class="label mb-4">§ 05 — Selected Work</div>
        <h2 class="display-md text-4xl md:text-6xl fade-in-up">
          Recent activations.
        </h2>
      </div>
    </div>

    <!-- Editorial rhythm: 7/5 · 4/4/4 · 5/7 auto-flows from the 12-col spans. -->
    <div class="grid grid-cols-12 gap-4 md:gap-5">
      {featuredWork.map((f, i) => (
        <a
          href={`/work/${f.slug}`}
          class={`work-card group col-span-12 ${f.span} img-wrap ${f.aspect} block relative fade-in-up fade-delay-${(i % 6) + 1}`}
        >
          <img src={f.data.thumbImage ?? f.data.heroImage} alt={f.data.heroAlt} />
          <figcaption class="caption absolute bottom-0 left-0 right-0 p-5 md:p-6 flex items-end justify-between gap-4">
            <div class="display-md text-lg md:text-xl">
              {f.data.title} <span class="work-arrow" aria-hidden="true">→</span>
            </div>
            <div class="mono text-xs" style="color: var(--cream-dim);">{f.data.year}</div>
          </figcaption>
        </a>
      ))}

      <!-- View all work tile -->
      <a
        href="/work"
        class="work-card work-tile group col-span-12 md:col-span-7 aspect-[4/5] md:aspect-[16/11] flex flex-col justify-between p-6 md:p-8 border rounded-[3px] fade-in-up fade-delay-6"
        style="border-color: var(--line); background: var(--bg-lift); color: var(--cream);"
      >
        <div class="display-md text-sm md:text-base" style="color: var(--cream-dim);">
          Selected activations. One western branch.
        </div>
        <div class="display-md text-3xl md:text-5xl">
          View all work <span class="work-arrow" aria-hidden="true">→</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section id="contact" class="px-6 md:px-10 py-20 min-h-[80vh] flex flex-col justify-center relative overflow-hidden">
    <div class="glow absolute inset-0"></div>
    <div class="relative text-center">
      <div class="label mb-6" style="color: var(--accent);">§ 06 — Start a Project</div>
      <h2 class="display text-[clamp(64px,16vw,140px)] md:text-[clamp(120px,20vw,320px)] leading-[0.9] tracking-[-0.04em]">
        Let's Chat<span class="dot-accent">.</span>
      </h2>
      <p class="mt-10 max-w-xl mx-auto text-[15px] leading-relaxed" style="color: var(--cream-dim);">
        Looking for a trusted partner on the ground in Western Canada? Send us the brief, a rough date, and the problem you're trying to solve.
      </p>

      <div class="mt-12 flex flex-col md:flex-row items-center justify-center gap-6">
        <a href="mailto:hello@studiopark.ca"
           class="btn inline-flex items-center gap-3 text-lg display-md px-8 py-4 border"
           style="border-color: var(--cream); color: var(--cream);">
          hello@studiopark.ca
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
        <span class="label">Typical reply within one business day</span>
      </div>
    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer class="px-6 md:px-10 pt-20 pb-10 border-t" style="border-color: var(--line);">
    <div class="grid grid-cols-12 gap-6 mb-16">
      <div class="col-span-12 md:col-span-5">
        <img src="/studiopark-logo.png" alt="Studio Park" class="logo-mark h-20 w-auto mb-6" />
        <p class="text-[14px] max-w-xs leading-relaxed" style="color: var(--cream-dim);">
          The western branch national agencies were missing. Western-based boots on the ground.
        </p>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="label mb-5">Services</div>
        <ul class="space-y-3 text-sm">
          <li><a href="/work" class="nav-link">Work</a></li>
          <li><a href="/content" class="nav-link">Content</a></li>
          <li><a href="/staffing" class="nav-link">Staffing</a></li>
          <li><a href="/consulting" class="nav-link">Consulting</a></li>
        </ul>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="label mb-5">Connect</div>
        <ul class="space-y-3 text-sm">
          <li><a href="/contact" class="nav-link">Contact</a></li>
          <li><a href="mailto:hello@studiopark.ca" class="nav-link">Email</a></li>
        </ul>
      </div>
      <div class="col-span-12 md:col-span-3">
        <div class="label mb-5">Visit</div>
        <p class="text-[14px] leading-relaxed" style="color: var(--cream-dim);">
          1933 10 Ave SW, #301<br/>
          Calgary, AB T3C 0K3<br/>
          Canada
        </p>
      </div>
    </div>

    <div class="h-px mb-8" style="background: var(--line);"></div>

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-xs mono" style="color: var(--cream-dim);">
      <div>© 2026 Studio Park Inc. All rights reserved.</div>
      <div class="flex items-center gap-5 flex-wrap">
        <span>51.0447° N  ·  114.0719° W</span>
        <span>Calgary, Alberta</span>
      </div>
    </div>
  </footer>


<style>
  /* §05 Selected Work cards — gentle lift + arrow reveal on hover.
     (Image scale is inherited from the global .img-wrap:hover rule.) */
  .work-card {
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .work-card:hover {
    transform: translateY(-4px);
  }
  .work-tile {
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
                background 0.4s ease, border-color 0.4s ease;
  }
  .work-tile:hover {
    background: var(--bg-soft);
    border-color: var(--cream-dim);
  }
  .work-arrow {
    display: inline-block;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .work-card:hover .work-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .work-card,
    .work-tile,
    .work-arrow {
      transition: none;
    }
    .work-card:hover,
    .work-card:hover .work-arrow {
      transform: none;
    }
    .work-card:hover .work-arrow {
      opacity: 1;
    }
  }
</style>

</BaseLayout>
