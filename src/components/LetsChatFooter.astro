---
// Shared massive closing CTA, rendered on every page except /contact and
// /staffing/apply (the form IS the CTA there). Imported directly into each
// qualifying page right before its own <footer> — BaseLayout has no shared
// footer element to anchor against (each page owns its own), so centralizing
// the render call there would place this after the legal footer instead of
// before it.
---

<section class="px-6 md:px-10 py-20 min-h-[80vh] flex flex-col justify-center relative overflow-hidden">
  <div class="glow absolute inset-0"></div>
  <div class="relative text-center">
    <h2 class="display text-[clamp(64px,16vw,140px)] md:text-[clamp(120px,20vw,320px)] leading-[0.9] tracking-[-0.04em]">
      Let's Chat<span class="dot-accent">.</span>
    </h2>
    <p class="mt-10 max-w-xl mx-auto text-[15px] leading-relaxed" style="color: var(--cream-dim);">
      Bring us the brief, the idea or the activation that needs a team on the ground.
    </p>
    <div class="mt-12 flex items-center justify-center">
      <a href="/contact" class="btn inline-flex items-center gap-3 text-lg display-md px-8 py-4 border" style="border-color: var(--cream); color: var(--cream);">
        Start a conversation
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
