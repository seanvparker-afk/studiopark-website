<style>
  /* Mapped to the site's design tokens (global.css :root), with brand fallbacks */
  .sp-coverage{
    --sp-bg:var(--bg,#14110F); --sp-panel:var(--bg-lift,#1A1613); --sp-line:var(--line,#2A2521);
    --sp-cream:var(--cream,#F4EFE6); --sp-muted:var(--cream-dim,#9A9186); --sp-orange:var(--accent,#E8552A);
  }
  .sp-eyebrow{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11px;
    letter-spacing:.22em;text-transform:uppercase;color:var(--sp-orange);margin:0 0 22px}
  .sp-h2{font-size:clamp(34px,6vw,58px);font-weight:800;line-height:.98;
    letter-spacing:-.02em;margin:0 0 18px;color:var(--sp-cream)}
  .sp-dim{color:var(--sp-muted)}
  .sp-lede{color:var(--sp-muted);font-size:16px;line-height:1.55;max-width:50ch;margin:0 0 36px}
  .sp-legend{display:flex;flex-wrap:wrap;gap:8px 26px;margin:0 0 14px;
    font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11px;
    letter-spacing:.12em;text-transform:uppercase;color:var(--sp-muted)}
  .sp-legend span{display:inline-flex;align-items:center;gap:9px}
  .sp-sw{width:12px;height:12px;display:inline-block;position:relative}
  .sp-sw.local::after{content:"";position:absolute;inset:2px;border-radius:50%;background:var(--sp-cream)}
  .sp-sw.hq::after{content:"";position:absolute;inset:1px;border-radius:50%;
    background:var(--sp-orange);box-shadow:0 0 0 2px rgba(232,85,42,.35)}
  .sp-map-frame{position:relative;border:1px solid var(--sp-line);background:var(--sp-panel);
    border-radius:2px;overflow:hidden}
  .sp-map{display:block;width:100%;height:auto}
  .sp-grat line{stroke:#3A332D;stroke-width:.5;opacity:.45}
  .sp-prov{fill:#241F1A;stroke:#574C40;stroke-width:1.1;stroke-linejoin:round}
  .sp-relief{fill:none;stroke-linecap:round;filter:url(#sp-soft)}
  .sp-relief.band{stroke:#6B5746;stroke-width:24;opacity:.16}
  .sp-relief.crest{stroke:#86705B;stroke-width:2.5;opacity:.30}
  .sp-node{cursor:pointer}
  .sp-dot{transition:r .2s}
  .sp-label{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:12px;
    letter-spacing:.07em;fill:var(--sp-cream);pointer-events:none;transition:fill .2s}
  .sp-tag{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:9px;
    letter-spacing:.16em;fill:var(--sp-orange);pointer-events:none}
  .sp-node:hover .sp-label,.sp-node:focus .sp-label,.sp-node.is-active .sp-label{fill:var(--sp-orange)}
  @keyframes sp-ping{0%{r:6;opacity:.5}70%{r:22;opacity:0}100%{opacity:0}}
  .sp-ping{fill:none;stroke:var(--sp-cream);stroke-width:1;animation:sp-ping 3s ease-out infinite}
  .sp-ping.hq{stroke:var(--sp-orange)}
  .sp-readout{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;
    border-top:1px solid var(--sp-line);padding:18px 20px;min-height:60px;
    font-family:ui-monospace,"SF Mono",Menlo,monospace}
  .sp-readout .sp-city{font-size:15px;letter-spacing:.06em;color:var(--sp-cream)}
  .sp-readout .sp-meta{font-size:12px;letter-spacing:.05em;color:var(--sp-muted)}
  .sp-hint{color:var(--sp-muted);font-size:12px}
  .sp-beyond{margin:26px 0 0;color:var(--sp-muted);font-size:14px;line-height:1.55;max-width:54ch}
  .sp-beyond b{color:var(--sp-cream);font-weight:600}
  @media (max-width:640px){
    .sp-label{font-size:15px} .sp-tag{font-size:11px}
  }
  @media (prefers-reduced-motion:reduce){.sp-ping{animation:none;opacity:0}}
</style>

<script>
  // Progressive enhancement: markup already renders without JS.
  const readout = document.getElementById("sp-readout");
  const nodes = Array.from(document.querySelectorAll(".sp-coverage .sp-node"));
  const reset = () => { readout.innerHTML = '<span class="sp-hint">Hover or tap a city.</span>'; };
  nodes.forEach(n => {
    const show = () => {
      nodes.forEach(o => o.classList.remove("is-active"));
      n.classList.add("is-active");
      readout.innerHTML =
        '<span class="sp-city">' + n.dataset.city + '</span>' +
        '<span class="sp-meta">' + n.dataset.meta + '</span>';
    };
    n.addEventListener("mouseenter", show);
    n.addEventListener("focus", show);
    n.addEventListener("click", show);
    n.addEventListener("mouseleave", () => { n.classList.remove("is-active"); reset(); });
    n.addEventListener("blur", () => { n.classList.remove("is-active"); reset(); });
  });
</script>
